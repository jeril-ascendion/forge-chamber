# Forge Chamber — Environment Variables
# Copy to .env and fill in your keys.

# LiveKit (free tier at livekit.io/cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Anthropic (claude API key)
ANTHROPIC_API_KEY=sk-ant-your-key

# Deepgram (free $200 credit at deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_key

# Cartesia (free tier at cartesia.ai)
CARTESIA_API_KEY=your_cartesia_key

# Frontend API URL override (for web/mobile builds)
VITE_API_URL=http://localhost:8765

# Backend runtime config
FORGE_DATA_DIR=./data
FORGE_PORT=8765
FORGE_DB_MODE=sqlite
FORGE_CHROMA_MODE=embedded
