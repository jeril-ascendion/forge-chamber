#!/bin/bash
# Pre-commit hook: prevent committing API keys
# Install: cp scripts/pre-commit-hook .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

if git diff --cached | grep -E 'sk-ant-[a-zA-Z0-9]+|gsk_[a-zA-Z0-9]{20,}|AKIA[A-Z0-9]{16}'; then
  echo ""
  echo "ERROR: Possible API key detected in staged changes."
  echo "Remove the key and use environment variables instead."
  echo ""
  echo "If this is a false positive, commit with: git commit --no-verify"
  exit 1
fi
exit 0
